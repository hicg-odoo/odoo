<menuitem id="menu_crm_ai_agent_run" name="Agent Runs" parent="menu_crm_ai_observability" action="action_crm_ai_agent_run" sequence="10"/>
<menuitem id="menu_crm_ai_agent_run_log" name="Run Logs" parent="menu_crm_ai_observability" action="action_crm_ai_agent_run_log" sequence="20"/>

</odoo>
